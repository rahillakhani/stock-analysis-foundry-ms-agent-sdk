{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint *)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck *)",
      "Bash(npm run typecheck)",
      "Bash(npm run test *)",
      "Bash(npm run test)",
      "Bash(npm test *)",
      "Bash(npm test)",
      "Bash(npm run build *)",
      "Bash(npm run build)",
      "Bash(npm run format *)",
      "Bash(npm run format)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(npx prisma validate *)",
      "Bash(npx prisma format *)",
      "Bash(npx prisma generate *)",
      "Bash(npm view *)",
      "Bash(npm ls *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npx prisma migrate *)",
      "Bash(docker compose down *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(npx prisma migrate reset *)",
      "Bash(npx prisma db push --force-reset *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.production)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-writes.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format-file.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
