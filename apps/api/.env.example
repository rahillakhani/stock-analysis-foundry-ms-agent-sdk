# Copy to apps/api/.env for local development. Placeholders only; never commit a real .env.
# In production, set these in the process environment (container, App Service settings, Key Vault refs).

# development | test | production
NODE_ENV=development
# 127.0.0.1 for local dev; 0.0.0.0 inside a container so the port is reachable.
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
