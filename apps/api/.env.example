# Copy to apps/api/.env for local development. Placeholders only; never commit a real .env.
# In production, set these in the process environment (container, App Service settings, Key Vault refs).

# development | test | production
NODE_ENV=development
# 127.0.0.1 for local dev; 0.0.0.0 inside a container so the port is reachable.
HOST=127.0.0.1
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# postgres (default) or memory (DB-less demo; data lost on restart).
STORAGE=postgres

# live (default): look up and research any NSE/BSE/NASDAQ/NYSE stock via Yahoo Finance (internet required).
# fixture: offline synthetic sample data for the built-in instrument list only.
RESEARCH_PROVIDER=live

# PostgreSQL (local Homebrew Postgres works; no password needed with local trust auth).
# Create the databases once:  createdb stock_analysis && createdb stock_analysis_test
# Apply migrations:           npm run db:deploy -w @stock-analysis/api   (and with DATABASE_URL set to the test DB)
DATABASE_URL=postgresql://<user>@localhost:5432/stock_analysis
# Used only by `npm run test:int`; tests TRUNCATE its tables, so never point it at real data.
DATABASE_URL_TEST=postgresql://<user>@localhost:5432/stock_analysis_test
